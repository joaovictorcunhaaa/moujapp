{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "context": ".",
    "dockerfile": "backend/Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "node dist/backend/server.js",
    "restartPolicyMaxRetries": 5,
    "restartPolicyWindow": 600
  },
  "variables": {
    "NODE_ENV": "production",
    "API_PORT": {
      "description": "API server port",
      "value": "3000"
    }
  },
  "volumes": [
    {
      "mountPath": "/app/logs",
      "size": "1Gi"
    }
  ]
}
