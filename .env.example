# ===== SUPABASE =====
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ===== API =====
VITE_API_URL=http://localhost:3000
API_PORT=3000
NODE_ENV=development

# ===== OPENAI =====
# Chave da API da OpenAI (https://platform.openai.com/api-keys)
# Copie este arquivo para .env.local e preencha com sua chave. Nunca faça commit do .env.local.
OPENAI_API_KEY=

# ===== DATABASE =====
DATABASE_URL=postgresql://user:password@localhost:5432/moujapp

# ===== PAYMENTS (STRIPE) =====
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret

# ===== EMAIL =====
RESEND_API_KEY=re_your-key
